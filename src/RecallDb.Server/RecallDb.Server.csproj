<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IpMatcher" Version="1.0.6" />
    <PackageReference Include="Watson" Version="7.*" />
    <PackageReference Include="SyslogLogging" Version="*" />
    <PackageReference Include="Inputty" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecallDb.Core\RecallDb.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="recalldb.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="clean.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="clean.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
