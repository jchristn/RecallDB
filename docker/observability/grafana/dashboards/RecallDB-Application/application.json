{
  "uid": "recalldb-application",
  "title": "RecallDB Application (Operations)",
  "tags": ["recalldb", "application"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "Total operations by transport (selected range)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (recalldb_origin) (increase(recalldb_operation_count_total[$__range]))", "legendFormat": "{{recalldb_origin}}", "instant": true }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operation rate by transport (origin)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (recalldb_origin) (rate(recalldb_operation_count_total[$__rate_interval]))", "legendFormat": "{{recalldb_origin}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Operation rate by resource",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (recalldb_resource) (rate(recalldb_operation_count_total[$__rate_interval]))", "legendFormat": "{{recalldb_resource}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Operation duration p95 by operation",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, recalldb_operation) (rate(recalldb_operation_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{recalldb_operation}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors by resource (non-success)",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (recalldb_resource) (rate(recalldb_operation_count_total{recalldb_outcome!=\"success\"}[$__rate_interval]))", "legendFormat": "{{recalldb_resource}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active operations",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(recalldb_operation_active)", "legendFormat": "active" }
      ]
    }
  ]
}
