{
  "uid": "recalldb-mcp",
  "title": "RecallDB MCP",
  "tags": ["recalldb", "mcp"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tool invocation rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (mcp_tool) (rate(recalldb_mcp_tool_invocations_total[$__rate_interval]))", "legendFormat": "{{mcp_tool}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool duration p95 by tool",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, mcp_tool) (rate(recalldb_mcp_tool_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{mcp_tool}}" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active invocations",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(recalldb_mcp_tool_active)", "legendFormat": "active" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Invocations by outcome",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (recalldb_outcome) (rate(recalldb_mcp_tool_invocations_total[$__rate_interval]))", "legendFormat": "{{recalldb_outcome}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate (non-success)",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (mcp_tool) (rate(recalldb_mcp_tool_invocations_total{recalldb_outcome!=\"success\"}[$__rate_interval]))", "legendFormat": "{{mcp_tool}}" }
      ]
    }
  ]
}
