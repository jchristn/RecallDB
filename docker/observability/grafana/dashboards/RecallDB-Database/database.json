{
  "uid": "recalldb-database",
  "title": "RecallDB Database (Storage)",
  "tags": ["recalldb", "database", "postgres"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "Total queries by operation (selected range)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (db_operation) (increase(recalldb_db_queries_total[$__range]))", "legendFormat": "{{db_operation}}", "instant": true }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Query rate by operation",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (db_operation) (rate(recalldb_db_queries_total[$__rate_interval]))", "legendFormat": "{{db_operation}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Query duration p95 by operation",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, db_operation) (rate(recalldb_db_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{db_operation}}" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active queries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(recalldb_db_active_queries)", "legendFormat": "active" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rows returned (p50 / p95)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(recalldb_db_rows_returned_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(recalldb_db_rows_returned_bucket[$__rate_interval])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query errors",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "qps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (db_operation) (rate(recalldb_db_queries_total{recalldb_outcome=\"error\"}[$__rate_interval]))", "legendFormat": "{{db_operation}}" }
      ]
    }
  ]
}
